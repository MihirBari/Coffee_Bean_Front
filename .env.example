# Google Maps & Places API Connector Configuration
# When you have your Google Maps API key from Google Cloud Console,
# create a file named .env (or .env.local) in the Front folder and paste:
#
# VITE_GOOGLE_MAPS_API_KEY=AIzaSy...YourActualGoogleApiKeyHere
#
# If left blank, the application automatically uses the built-in 
# zero-configuration open geocoder and instant Indian locality suggestions.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL
# Change this when deploying to Render, Railway, AWS, or custom cloud domain
//VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=https://coffee-bean-back.onrender.com/api


# Google Maps & Places API Connector Configuration
# When you have your Google Maps API key from Google Cloud Console, paste it below:
# If left blank, the application automatically uses the built-in 
# zero-configuration open geocoder and instant Indian locality suggestions.
VITE_GOOGLE_MAPS_API_KEY=